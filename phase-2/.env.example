# Copy this to .env and fill values for production
# Neon/Postgres connection (required for production)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret for signing tokens
BETTER_AUTH_SECRET=replace-with-a-strong-secret

# If using OpenAI ChatKit / domain-key based auth on frontend
NEXT_PUBLIC_OPENAI_DOMAIN_KEY=replace-with-openai-domain-key
